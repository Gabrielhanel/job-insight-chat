# --- Versão gratuita: só estas duas (cadastro grátis em developer.adzuna.com) ---
# Serviço próprio de vagas, com base de dados dele
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Opcionais (pagos/limitados) ---
# Com esta chave, a extração passa a usar a Claude em vez do dicionário
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-haiku-4-5-20251001

PROVEDOR=jsearch # ou adzuna
# Chave do OpenWeb Ninja (app.openwebninja.com > Account > Settings):
OPENWEBNINJA_API_KEY=